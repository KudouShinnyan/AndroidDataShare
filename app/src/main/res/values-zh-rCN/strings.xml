    <string name="notify_mount_title">共享已终止</string>
    <string name="notify_mount_body">检测到版本变化，挂载已卸载、补齐项已清空。请先在主应用完成资源更新，再点「重新共享」。</string>
    <string name="notify_both_title">检测到版本变化</string>
    <string name="notify_both_body">硬链接组待重建，另有挂载组已终止。请打开应用查看。</string>
    <string name="notify_foreground_title">后台检测已开启</string>
